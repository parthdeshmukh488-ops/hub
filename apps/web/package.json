{
  "name": "@leash/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Owner web control panel, pairing, Solana Actions and landing page.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright.fixtures.config.ts && playwright test -c playwright.live.config.ts",
    "e2e:stack": "tsx e2e/live-stack.ts"
  },
  "dependencies": {
    "@leash/contracts": "workspace:*",
    "@leash/sdk": "workspace:*",
    "@radix-ui/react-switch": "1.3.7",
    "@solana/kit": "8.4.0",
    "@solana/react": "8.4.0",
    "@tanstack/react-query": "5.104.0",
    "@wallet-standard/react": "1.0.3",
    "@wallet-standard/ui": "1.0.3",
    "lucide-react": "1.48.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@leash/indexer": "workspace:*",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "litesvm": "1.5.0",
    "tailwindcss": "4.3.3"
  }
}
