{
  "name": "@leash/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed TypeScript client for the Leash program: PDAs, reads, owner and agent operations, policy evaluator, event decoding.",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "devnet:setup": "tsx scripts/devnet-setup.ts",
    "devnet:smoke": "tsx scripts/devnet-smoke.ts"
  },
  "dependencies": {
    "@leash/contracts": "workspace:*",
    "@solana-program/compute-budget": "0.19.0",
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana/kit": "8.4.0"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.5.0",
    "@solana-program/memo": "0.15.0",
    "@vitest/coverage-v8": "5.0.2",
    "codama": "1.11.0",
    "fast-check": "4.10.2",
    "litesvm": "1.5.0",
    "tsx": "4.23.15"
  }
}
