{
  "name": "@leash/sentinel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sentinel: anomaly rules, guardian freezes and Telegram alerts.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "telegram:test": "tsx --env-file-if-exists=../../.env scripts/telegram-test.ts"
  },
  "dependencies": {
    "@leash/contracts": "workspace:*",
    "@leash/sdk": "workspace:*",
    "@solana/kit": "8.4.0",
    "grammy": "1.46.0",
    "pino": "10.3.1",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "tsx": "4.23.15"
  }
}
