{
  "name": "leash",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test && pnpm check:root",
    "check:root": "biome check scripts biome.json package.json turbo.json && tsc -p scripts/tsconfig.json && pnpm check:secrets && pnpm check:env && pnpm check:ignored",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check:env": "tsx scripts/env-example.ts --check",
    "env:example": "tsx scripts/env-example.ts --write",
    "format": "biome format --write .",
    "check:ignored": "tsx scripts/check-ignored.ts",
    "keys": "tsx scripts/keys.ts",
    "devnet:check": "tsx scripts/devnet-check.ts",
    "devnet:setup": "pnpm --filter @leash/sdk devnet:setup",
    "devnet:smoke": "pnpm --filter @leash/sdk devnet:smoke",
    "owner:approve": "pnpm --filter @leash/sdk owner:approve",
    "owner:unfreeze": "pnpm --filter @leash/sdk owner:unfreeze",
    "localnet": "bash scripts/localnet.sh",
    "artifact:subscriptions": "bash scripts/subscriptions-artifact.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@leash/contracts": "workspace:*",
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "turbo": "2.11.5",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
