# Generated from ENV_VARS in packages/contracts/src/config.ts. Do not edit by hand:
# change the list, then run `pnpm env:example`.
# Keypair variables hold file paths, never secrets. Never commit a real .env file.

# localnet or devnet (used by: all)
LEASH_CLUSTER=localnet

# Override the RPC URL (e.g. a Helius devnet URL) (used by: all)
LEASH_RPC_URL=

# Override the RPC WebSocket URL (used by: all)
LEASH_WS_URL=

# Override the Leash program ID (used by: all)
LEASH_PROGRAM_ID=

# Override for a devnet fallback deployment of Subscriptions (used by: all)
LEASH_SUBSCRIPTIONS_PROGRAM_ID=

# Override the USDC mint (used by: all)
LEASH_USDC_MINT=

# Compute unit price for Leash transactions (max 50000) (used by: sdk, x402)
LEASH_PRIORITY_FEE_MICROLAMPORTS=1

# pino log level (used by: services)
LOG_LEVEL=info

# HTTP port (used by: indexer)
INDEXER_PORT=4100

# libSQL URL (used by: indexer)
INDEXER_DB_URL=file:./data/indexer.db

# chain, or fixtures to replay the demo storyline without a chain (used by: indexer)
INDEXER_SOURCE=chain

# Signatures fetched at startup (used by: indexer)
INDEXER_BACKFILL_LIMIT=1000

# Backfill polling interval (covers WebSocket gaps) (used by: indexer)
INDEXER_POLL_INTERVAL_MS=15000

# Allowed CORS origin (used by: indexer, facilitator)
WEB_ORIGIN=http://localhost:3000

# HTTP port (used by: facilitator)
FACILITATOR_PORT=4200

# Path to the fee-payer keypair (pays SOL network fees only) (used by: facilitator)
FACILITATOR_FEE_PAYER_KEYPAIR=.keys/facilitator.json

# HTTP port (used by: merchant-demo)
MERCHANT_PORT=4300

# Merchant wallet address that receives payments (used by: merchant-demo)
MERCHANT_PAY_TO=

# Facilitator used by the merchant (used by: merchant-demo)
MERCHANT_FACILITATOR_URL=http://localhost:4200

# off serves paid routes for free (development before the x402 layer is ready) (used by: merchant-demo)
MERCHANT_PAYMENTS=on

# Wallet address the adversarial lab tries to get paid (used by: merchant-demo)
LAB_ATTACKER_WALLET=

# Indexer base URL (used by: sentinel)
SENTINEL_INDEXER_URL=http://localhost:4100

# Path to the guardian keypair (can only freeze and reject) (used by: sentinel)
SENTINEL_GUARDIAN_KEYPAIR=.keys/guardian.json

# Allow rule-triggered guardian freezes (used by: sentinel)
SENTINEL_AUTOFREEZE=false

# Web app URL used in alert links (used by: sentinel)
SENTINEL_WEB_URL=http://localhost:3000

# Telegram bot token; alerts are only logged if unset (used by: sentinel)
TELEGRAM_BOT_TOKEN=

# Telegram chat that receives alerts (used by: sentinel)
TELEGRAM_CHAT_ID=

# Path to the agent keypair; created on first run if missing (used by: agent-demo, mcp)
AGENT_KEYPAIR=~/.config/leash/agent.json

# Owner wallet address whose principal holds this agent (used by: agent-demo, mcp)
AGENT_OWNER=

# llm (Claude) or scripted (deterministic replay) (used by: agent-demo)
AGENT_MODE=llm

# Claude model ID for the demo agent (used by: agent-demo)
AGENT_MODEL=claude-opus-5-5

# Anthropic API key (demo agent, LLM mode only) (used by: agent-demo)
ANTHROPIC_API_KEY=

# Base URL of the demo merchant (used by: agent-demo)
AGENT_MERCHANT_URL=http://localhost:4300

# Cluster shown and used by the web app (used by: web)
NEXT_PUBLIC_LEASH_CLUSTER=localnet

# Browser RPC URL (defaults per cluster) (used by: web)
NEXT_PUBLIC_RPC_URL=

# Indexer REST base URL (used by: web)
NEXT_PUBLIC_INDEXER_URL=http://localhost:4100

# Indexer WebSocket URL (used by: web)
NEXT_PUBLIC_INDEXER_WS_URL=ws://localhost:4100/v1/stream

# Public URL of the web app (pairing and Action links) (used by: web)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# indexer, or fixtures to build the UI without any backend (used by: web)
NEXT_PUBLIC_DATA_SOURCE=indexer
